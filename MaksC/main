import customtkinter as ctk
import random

ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("green")


class SnakeGame:
    def __init__(self, root):
        self.root = root
        self.root.title("🐍 Змійка")
        self.root.geometry("650x780")
        self.root.resizable(False, False)


        self.snake_color = "lime"
        self.background_color = "black"

        self.canvas_size = 600
        self.cell_size = 20

        self.snake = []
        self.food = None

        self.direction = "Right"
        self.next_direction = "Right"

        self.score = 0
        self.game_running = False

        self.title = ctk.CTkLabel(
            root,
            text="🐍 ЗМІЙКА",
            font=("Arial", 30, "bold")
        )
        self.title.pack(pady=10)


        self.score_label = ctk.CTkLabel(
            root,
            text="Яблука: 0",
            font=("Arial", 18)
        )
        self.score_label.pack()


        self.canvas = ctk.CTkCanvas(
            root,
            width=self.canvas_size,
            height=self.canvas_size,
            bg=self.background_color,
            highlightthickness=2
        )
        self.canvas.pack(pady=10)


        settings_frame = ctk.CTkFrame(root)
        settings_frame.pack(pady=5)


        self.snake_menu = ctk.CTkOptionMenu(
            settings_frame,
            values=[
                "Зелена",
                "Синя",
                "Червона",
                "Фіолетова",
                "Жовта",
                "Біла"
            ],
            command=self.change_snake_color
        )
        self.snake_menu.set("Зелена")
        self.snake_menu.grid(
            row=0,
            column=0,
            padx=10,
            pady=10
        )


        self.background_menu = ctk.CTkOptionMenu(
            settings_frame,
            values=[
                "Чорний",
                "Сірий",
                "Синій",
                "Білий"
            ],
            command=self.change_background
        )
        self.background_menu.set("Чорний")
        self.background_menu.grid(
            row=0,
            column=1,
            padx=10,
            pady=10
        )


        self.restart_button = ctk.CTkButton(
            root,
            text="🔄 Перезапустити",
            width=200,
            height=40,
            command=self.start_game
        )
        self.restart_button.pack(pady=5)


        self.root.bind(
            "<KeyPress>",
            self.key_pressed
        )

        self.start_game()


    def change_snake_color(self, choice):

        colors = {
            "Зелена": "lime",
            "Синя": "blue",
            "Червона": "red",
            "Фіолетова": "purple",
            "Жовта": "yellow",
            "Біла": "white"
        }

        self.snake_color = colors[choice]

        self.draw()


    def change_background(self, choice):

        backgrounds = {
            "Чорний": "black",
            "Сірий": "gray20",
            "Синій": "dark blue",
            "Білий": "white"
        }

        self.background_color = backgrounds[choice]

        self.canvas.configure(
            bg=self.background_color
        )

        self.draw()


    def start_game(self):

        self.snake = [
            [300, 300],
            [280, 300],
            [260, 300]
        ]

        self.direction = "Right"
        self.next_direction = "Right"
        self.score = 0
        self.game_running = True

        self.score_label.configure(
            text="Яблука: 0"
        )

        self.create_food()

        self.draw()

        self.root.focus_force()

        self.move()

    def create_food(self):

        while True:

            x = random.randrange(
                0,
                self.canvas_size,
                self.cell_size
            )

            y = random.randrange(
                0,
                self.canvas_size,
                self.cell_size
            )

            if [x, y] not in self.snake:
                self.food = [x, y]
                break


    def draw(self):

        self.canvas.delete("all")


        x, y = self.food


        if (self.score + 1) % 10 == 0:
            food_color = "yellow"
            size = self.cell_size - 2
        else:
            food_color = "red"
            size = self.cell_size - 6

        offset = (self.cell_size - size) // 2

        self.canvas.create_oval(
            x + offset,
            y + offset,
            x + offset + size,
            y + offset + size,
            fill=food_color,
            outline=""
        )


        for segment in self.snake:

            x, y = segment

            self.canvas.create_rectangle(
                x + 1,
                y + 1,
                x + self.cell_size - 1,
                y + self.cell_size - 1,
                fill=self.snake_color,
                outline=""
            )



    def key_pressed(self, event):

        key = event.keysym


        if key.lower() == "r":
            self.start_game()
            return

        if key == "Up" and self.direction != "Down":
            self.next_direction = "Up"

        elif key == "Down" and self.direction != "Up":
            self.next_direction = "Down"

        elif key == "Left" and self.direction != "Right":
            self.next_direction = "Left"

        elif key == "Right" and self.direction != "Left":
            self.next_direction = "Right"

    def move(self):

        if not self.game_running:
            return

        self.direction = self.next_direction

        head_x, head_y = self.snake[0]

        if self.direction == "Up":
            head_y -= self.cell_size

        elif self.direction == "Down":
            head_y += self.cell_size

        elif self.direction == "Left":
            head_x -= self.cell_size

        elif self.direction == "Right":
            head_x += self.cell_size

        new_head = [head_x, head_y]

        if (
            head_x < 0
            or head_x >= self.canvas_size
            or head_y < 0
            or head_y >= self.canvas_size
        ):
            self.game_over()
            return


        if new_head in self.snake:
            self.game_over()
            return

        self.snake.insert(0, new_head)


        if new_head == self.food:

            self.score += 1

            self.score_label.configure(
                text=f"Яблука: {self.score}"
            )


            if self.score % 10 == 0:


                self.snake.append(self.snake[-1])
                self.snake.append(self.snake[-1])

            self.create_food()

        else:
            self.snake.pop()

        self.draw()

        speed = max(
            60,
            150 - self.score * 5
        )

        self.root.after(
            speed,
            self.move
        )


    def game_over(self):

        self.game_running = False

        self.canvas.create_text(
            self.canvas_size // 2,
            self.canvas_size // 2 - 20,
            text="GAME OVER",
            fill="red",
            font=("Arial", 40, "bold")
        )

        self.canvas.create_text(
            self.canvas_size // 2,
            self.canvas_size // 2 + 30,
            text=f"Яблук: {self.score}",
            fill="white",
            font=("Arial", 22)
        )


root = ctk.CTk()
game = SnakeGame(root)
root.mainloop()
